{
  "expo": {
    "name": "CozyNCR",
    "slug": "cozyncr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cozyncr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cyancode.appCozyNCR"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.cyancode.appCozyNCR"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df0beaaf-2104-4364-96d6-8ace81b9ded4"
      }
    },
    "owner": "cozyncr",
    "updates": {
      "url": "https://u.expo.dev/df0beaaf-2104-4364-96d6-8ace81b9ded4"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
