{
  "expo": {
    "name": "CozyNCR",
    "slug": "cozyncr",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cozyncr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#ffffff",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.cozyncr.cozyncr",
      "buildNumber": "1",
      "associatedDomains": ["applinks:cozyncr.com", "applinks:cozyncr.com"],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tel",
          "mailto",
          "maps",
          "comgooglemaps",
          "tel",
          "mailto",
          "maps",
          "comgooglemaps"
        ],
        "NSCameraUsageDescription": "CozyNCR needs camera access to let hosts upload property photos.",
        "NSPhotoLibraryUsageDescription": "CozyNCR needs access to your photos so you can upload a profile picture.",
        "NSLocationWhenInUseUsageDescription": "We use your location to show you nearby hourly stays in the NCR region.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "versionCode": 20,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "package": "com.cozyncr.cozyncr",
      "permissions": ["POST_NOTIFICATIONS"],
      "useNextNotificationsApi": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "cozyncr.com",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df0beaaf-2104-4364-96d6-8ace81b9ded4"
      }
    },
    "owner": "cozyncr",
    "updates": {
      "url": "https://u.expo.dev/df0beaaf-2104-4364-96d6-8ace81b9ded4"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
